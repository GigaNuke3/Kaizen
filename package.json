{
  "name": "kaizen",
  "version": "1.0.0",
  "description": "Kaizen (改善) — a local-first self-improvement companion built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron . --ozone-platform=x11",
    "start:win": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "User <user@example.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.kaizen.app",
    "productName": "Kaizen",
    "files": [
      "main.js",
      "index.html",
      "src/**",
      "assets/**",
      "database/**",
      "node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/desktop/kaizen_desktop_icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/desktop/kaizen_desktop_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}