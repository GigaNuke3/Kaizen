{
  "name": "kaizen",
  "version": "1.2.2",
  "description": "Kaizen (改善) — a local-first self-improvement companion built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron . --ozone-platform=x11",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage deb rpm"
  },
  "keywords": [],
  "author": "User <user@example.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.kaizen.app",
    "productName": "Kaizen",
    "files": [
      "main.js",
      "index.html",
      "src/**",
      "assets/**",
      "database/backend.js",
      "node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/desktop/kaizen_desktop_icon.png",
      "category": "Utility",
      "artifactName": "Kaizen.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/desktop/kaizen_desktop_icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Kaizen-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/desktop/kaizen_desktop_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "Kaizen-Setup.${ext}"
    }
  }
}
